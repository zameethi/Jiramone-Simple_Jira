# Configurações do Banco de Dados PostgreSQL
POSTGRES_USER=jiramone
POSTGRES_PASSWORD=password123
POSTGRES_DB=jiramone

# String de Conexão Prisma (para rodar local fora do docker)
DATABASE_URL="postgresql://jiramone:password123@localhost:5432/jiramone?schema=public"

# Portas dos Serviços
BACKEND_PORT=3000
FRONTEND_PORT=3001

# Chave secreta JWT para autenticação
JWT_SECRET=jiramone-jwt-secret-chavedeprotecao-2026

# URL da API consumida pelo Frontend
NEXT_PUBLIC_API_URL=http://localhost:3000
